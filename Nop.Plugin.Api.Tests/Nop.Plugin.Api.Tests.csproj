<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
			<TargetFramework>net9.0</TargetFramework>
			<Version>4.0.0.0</Version>
			<Authors>Nop-Templates, Ltd</Authors>
			<Company>Nop-Templates, Ltd</Company>
			<Description>The project contains a set of classes for testing of Nop.Plugin.Api</Description>
			<Copyright>Copyright © Nop-Templates, Ltd</Copyright>
			<RepositoryType>Git</RepositoryType>
			<Product>Nop.Plugin.Api.Tests</Product>
			<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>
	<ItemGroup>
	  <PackageReference Include="NUnit" Version="4.3.1" />
	  <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
	  <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
	  <PackageReference Include="NSubstitute" Version="5.3.0" />
	  <PackageReference Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
	  <PackageReference Include="Autofac.Extras.Moq" Version="7.0.0" />
	  <PackageReference Include="Moq" Version="4.20.72" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\..\nopCommerce\src\Libraries\Nop.Core\Nop.Core.csproj" />
	  <ProjectReference Include="..\..\nopCommerce\src\Libraries\Nop.Services\Nop.Services.csproj" />
	  <ProjectReference Include="..\Nop.Plugin.Api\Nop.Plugin.Api.csproj" />
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="Properties\" />
	</ItemGroup>
	<ItemGroup>
	  <!-- Exclude tests that need API signature updates -->
	  <Compile Remove="ControllersTests/**/*.cs" />
	  <Compile Remove="ModelBinderTests/**/*.cs" />
	  <Compile Remove="ConvertersTests/**/*.cs" />

	  <!-- Exclude service tests with API changes -->
	  <Compile Remove="ServicesTests/Categories/**/*.cs" />
	  <Compile Remove="ServicesTests/Orders/**/*.cs" />
	  <Compile Remove="ServicesTests/ProductCategoryMappings/**/*.cs" />
	  <Compile Remove="ServicesTests/Products/**/*.cs" />
	  <Compile Remove="ServicesTests/ShoppingCartItems/**/*.cs" />
	</ItemGroup>
</Project>
